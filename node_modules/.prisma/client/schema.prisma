generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  candidate
  company_admin
  company_recruiter
  super_admin
  admin_support
}

enum UserStatus {
  active
  inactive
  suspended
}

enum CompanyStatus {
  active
  inactive
  suspended
  pending_approval
}

enum CompanyRole {
  admin
  recruiter
  editor
  viewer
}

enum JobStatus {
  draft
  active
  paused
  closed
}

enum ApplicationStatus {
  applied
  reviewing
  preselected
  interview_scheduled
  interview_confirmed
  hired
  rejected
  cancelled
}

enum DocumentStatus {
  pending
  uploaded
  approved
  rejected
  expired
}

enum InterviewStatus {
  scheduled
  pending_confirmation
  confirmed
  rescheduled
  completed
  cancelled
  no_show
}

enum MessageStatus {
  draft
  sent
  unread
  read
  pending
  responded
  closed
  cancelled
}

enum MessageType {
  interview_invitation
  document_request
  status_update
  general_message
  reminder
}

enum BillingStatus {
  paid
  pending
  overdue
}

enum PlanStatus {
  active
  past_due
  cancelled
}

model User {
  id           String     @id @default(uuid())
  email        String?    @unique
  phone        String?    @unique
  passwordHash String?
  role         UserRole
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  candidateProfile   CandidateProfile?
  companyUsers       CompanyUser[]
  applicationNotes   ApplicationNote[]
  interviewResults   InterviewResult[]
  activityLogs       ActivityLog[]
  passwordRecoveries PasswordRecovery[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
}

model PasswordRecovery {
  id         String    @id @default(uuid())
  userId     String
  code       String
  resetToken String?
  expiresAt  DateTime
  verified   Boolean   @default(false)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([resetToken])
}

model CandidateProfile {
  id                   String     @id @default(uuid())
  userId               String     @unique
  fullName             String
  city                 String?
  country              String?    @default("Nicaragua")
  phone                String?
  desiredJobType       String?
  availability         String?
  salaryExpectationMin Int?
  salaryExpectationMax Int?
  experienceLevel      String?
  educationLevel       String?
  profileCompletion    Int        @default(0)
  status               UserStatus @default(active)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications     Application[]
  documents        CandidateDocument[]
  interviews       Interview[]
  messages         Message[]
  messageResponses MessageResponse[]
  savedJobs        SavedJob[]

  @@index([userId])
  @@index([desiredJobType])
  @@index([city])
  @@index([status])
}

model Company {
  id        String        @id @default(uuid())
  name      String
  slug      String        @unique
  legalName String?
  email     String?
  phone     String?
  city      String?
  country   String?       @default("Nicaragua")
  address   String?
  website   String?
  logoUrl   String?
  planId    String?
  status    CompanyStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  plan                 Plan?                 @relation(fields: [planId], references: [id])
  users                CompanyUser[]
  jobs                 Job[]
  interviews           Interview[]
  messages             Message[]
  messageTemplates     MessageTemplate[]
  billingSubscriptions BillingSubscription[]
  billingPayments      BillingPayment[]

  @@index([planId])
  @@index([status])
  @@index([slug])
}

model CompanyUser {
  id        String      @id @default(uuid())
  companyId String
  userId    String
  role      CompanyRole @default(admin)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model JobCategory {
  id       String  @id
  name     String
  icon     String?
  isActive Boolean @default(true)

  jobs Job[]
}

model Job {
  id             String    @id @default(uuid())
  companyId      String
  categoryId     String?
  title          String
  description    String?
  requirements   String[]
  benefits       String[]
  city           String?
  country        String?   @default("Nicaragua")
  salaryMin      Int?
  salaryMax      Int?
  currency       String    @default("NIO")
  employmentType String?
  modality       String?
  status         JobStatus @default(active)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     JobCategory?  @relation(fields: [categoryId], references: [id])
  applications Application[]
  savedJobs    SavedJob[]
  interviews   Interview[]

  @@index([companyId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  candidateId String
  status      ApplicationStatus @default(applied)
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate  CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviews Interview[]
  messages   Message[]
  notes      ApplicationNote[]

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([status])
}

model ApplicationNote {
  id            String   @id @default(uuid())
  applicationId String
  authorUserId  String
  note          String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorUserId], references: [id])

  @@index([applicationId])
}

model SavedJob {
  id          String   @id @default(uuid())
  candidateId String
  jobId       String
  createdAt   DateTime @default(now())

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
}

model DocumentType {
  id         String  @id
  label      String
  isRequired Boolean @default(false)
}

model CandidateDocument {
  id          String         @id @default(uuid())
  candidateId String
  type        String
  fileUrl     String?
  status      DocumentStatus @default(pending)
  uploadedAt  DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([status])
  @@index([type])
}

model Interview {
  id                String          @id @default(uuid())
  applicationId     String
  companyId         String
  candidateId       String
  jobId             String
  date              DateTime
  modality          String
  location          String?
  meetingUrl        String?
  status            InterviewStatus @default(scheduled)
  notesForCandidate String?
  responsibleUserId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company     Company          @relation(fields: [companyId], references: [id])
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id])
  job         Job              @relation(fields: [jobId], references: [id])
  result      InterviewResult?

  @@index([applicationId])
  @@index([companyId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([date])
}

model InterviewResult {
  id          String   @id @default(uuid())
  interviewId String   @unique
  result      String
  notes       String?
  createdAt   DateTime @default(now())
  createdBy   String

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [createdBy], references: [id])

  @@index([interviewId])
}

model Message {
  id              String        @id @default(uuid())
  companyId       String
  candidateId     String
  applicationId   String?
  parentMessageId String?
  type            MessageType
  title           String
  body            String
  status          MessageStatus @default(sent)
  sentAt          DateTime?
  readAt          DateTime?
  respondedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company     Company           @relation(fields: [companyId], references: [id])
  candidate   CandidateProfile  @relation(fields: [candidateId], references: [id])
  application Application?      @relation(fields: [applicationId], references: [id])
  parent      Message?          @relation("MessageThread", fields: [parentMessageId], references: [id])
  children    Message[]         @relation("MessageThread")
  responses   MessageResponse[]

  @@index([companyId])
  @@index([candidateId])
  @@index([applicationId])
  @@index([status])
  @@index([type])
}

model MessageResponse {
  id           String   @id @default(uuid())
  messageId    String
  candidateId  String
  responseType String
  body         String?
  createdAt    DateTime @default(now())

  message   Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  candidate CandidateProfile @relation(fields: [candidateId], references: [id])

  @@index([messageId])
  @@index([candidateId])
}

model MessageTemplate {
  id        String      @id @default(uuid())
  companyId String?
  name      String
  type      MessageType
  subject   String?
  body      String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([type])
}

model Plan {
  id                     String   @id
  name                   String
  price                  Int
  currency               String   @default("NIO")
  publicationLimit       Int?
  userLimit              Int?
  visibleCandidatesLimit Int?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  companies     Company[]
  subscriptions BillingSubscription[]
  payments      BillingPayment[]
}

model BillingSubscription {
  id        String     @id @default(uuid())
  companyId String
  planId    String
  status    PlanStatus @default(active)
  startDate DateTime   @default(now())
  endDate   DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([planId])
  @@index([status])
}

model BillingPayment {
  id          String        @id @default(uuid())
  companyId   String
  planId      String
  amount      Int
  currency    String        @default("NIO")
  status      BillingStatus @default(pending)
  paymentDate DateTime?
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([planId])
  @@index([status])
}

model PlatformSettings {
  id        String   @id @default("global")
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(uuid())
  actorUserId String?
  entityType  String
  entityId    String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}
